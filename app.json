{
  "expo": {
    "name": "KADRAN",
    "slug": "kadran-klasik",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0806",
    "scheme": "kadran",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kadran.klasik",
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0806",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kadran.klasik",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "KADRAN",
      "themeColor": "#0B0806",
      "backgroundColor": "#0B0806"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0806",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0806"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KADRAN hızınızı GPS ile ölçmek için konumunuzu kullanır."
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
